package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "aera-gpu-probe",
    srcs: ["egl_probe.cpp"],
    header_libs: ["libEGL_headers", "libGLESv2_headers"],
    shared_libs: ["libdl", "libnativewindow"],
    stl: "none",
    cflags: ["-Wall", "-Wextra", "-Werror", "-Os"],
}
