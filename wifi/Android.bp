license {
    name: "aera_infiniti_qrtr_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-BSD-3-Clause"],
    license_text: ["qrtr/LICENSE"],
}

cc_library_static {
    name: "libaera_infiniti_qrtr",
    licenses: ["aera_infiniti_qrtr_license"],
    recovery_available: true,
    srcs: ["qrtr/lib/qrtr.c", "qrtr/lib/qmi.c", "qrtr/lib/logging.c"],
    local_include_dirs: ["qrtr/include"],
    export_include_dirs: ["qrtr/include"],
    cflags: ["-D_GNU_SOURCE", "-Wno-sign-compare"],
}

cc_binary {
    name: "aera-infiniti-wlan-mac",
    recovery: true,
    srcs: ["aera_wlan_mac.c"],
    static_libs: ["libaera_infiniti_qrtr"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}
