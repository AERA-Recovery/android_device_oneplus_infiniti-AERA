on init
    start aera-infiniti-wlan-mac

on property:twrp.modules.loaded=true
    start aera-infiniti-wlan-mac
    setprop sys.aera.wlan.up 0
    chmod 222 /sys/bus/platform/drivers/cnss2/b0000000.qcom,cnss-peach/fs_ready
    write /sys/bus/platform/drivers/cnss2/b0000000.qcom,cnss-peach/fs_ready 1
    start aera-wlan-ready

on property:wifi.driver.ready=true
    mkdir /tmp/recovery 0777 root root
    mkdir /tmp/recovery/sockets 0777 root root
    start wpa_supplicant

on property:sys.aera.wlan.up=1 && property:wifi.driver.ready=true
    setprop sys.aera.wlan.up 0
    mkdir /tmp/recovery 0777 root root
    mkdir /tmp/recovery/sockets 0777 root root
    start wpa_supplicant

service wpa_supplicant /system/bin/wpa_supplicant -Dnl80211 -iwlan0 -dd -O/tmp/recovery/sockets -c/vendor/etc/wifi/wpa_supplicant.conf
    disabled
    seclabel u:r:recovery:s0

# Serve the recovery MAC locally instead of waiting for the offline modem DMS.
service aera-infiniti-wlan-mac /system/bin/aera-infiniti-wlan-mac
    class core
    disabled
    oneshot
    user root
    group root
    seclabel u:r:recovery:s0
    stdio_to_kmsg

service aera-wlan-ready /system/bin/sh -c "until test -e /sys/class/net/wlan0; do sleep 1; done; setprop wifi.driver.ready true"
    disabled
    oneshot
    user root
    group root
    seclabel u:r:recovery:s0
